# Copy to .env.local and fill in. .env.local is git-ignored: never commit real keys.

# ---- Brain: any AI can be used. Tried in this order; unconfigured ones are skipped,
# ---- and if one fails the next one answers.
BRAIN_ORDER=claude,gemini,local

# Claude (Anthropic): https://console.anthropic.com
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_SEARCH=1

# Local / self-hosted model, any OpenAI-compatible server (Ollama, LM Studio, vLLM)
# e.g. Ollama: http://localhost:11434/v1  (run: ollama pull qwen2.5:7b)
LOCAL_LLM_URL=
# LOCAL_LLM_MODEL=qwen2.5:7b
# LOCAL_LLM_KEY=

# ---- Speech (listening + voice)
# Default: Google Gemini, using GEMINI_API_KEY above. Free tier, no server needed.
# GEMINI_TTS_VOICE=Sulafat
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# GEMINI_STT_MODEL=gemini-3.8-flash
# Optional: our self-hosted OmniVoice engine (speech/ folder on a GPU machine).
# Setting SPEECH_URL makes it the speech engine (or force with SPEECH_PROVIDER=gemini|omnivoice).
SPEECH_URL=
SPEECH_TOKEN=

# ---- Public info for the privacy page (not secret)
NEXT_PUBLIC_REPO_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
