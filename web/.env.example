# Copy to .env.local and fill in. .env.local is git-ignored: never commit real keys.

# ---- Sign-in: Clerk (development instance). Dashboard -> API keys.
# Google, Apple and email code are switched on in the Clerk dashboard, not here.
# For requireUser() to get an email, add {"email": "{{user.primary_email_address}}"} to
# Sessions -> Customize session token. Without it, email is null (no extra network call).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login

# ---- Brain: any AI can be used. Tried in this order; unconfigured ones are skipped,
# ---- and if one fails the next one answers.
BRAIN_ORDER=claude,deepseek,gemini,local

# Claude (Anthropic): https://console.anthropic.com
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# DeepSeek: https://platform.deepseek.com/api_keys (OpenAI-compatible, same agent tools)
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_SEARCH=1

# Local / self-hosted model, any OpenAI-compatible server (Ollama, LM Studio, vLLM)
# e.g. Ollama: http://localhost:11434/v1  (run: ollama pull qwen2.5:7b)
LOCAL_LLM_URL=
# LOCAL_LLM_MODEL=qwen2.5:7b
# LOCAL_LLM_KEY=

# ---- Speech (listening + voice)
# Azure Speech (recommended): free F0 tier, Mongolian voice mn-MN-YesuiNeural.
# Azure portal -> create "Speech" resource (pricing tier Free F0) -> Keys and Endpoint.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# AZURE_SPEECH_ENDPOINT=https://<resource>.cognitiveservices.azure.com
# Voices per style and language, e.g. AZURE_VOICE_JARVIS_EN=en-GB-RyanNeural
# AZURE_SPEECH_RATE=0%
# Default: Google Gemini, using GEMINI_API_KEY above. Free tier, no server needed.
# GEMINI_TTS_VOICE=Sulafat
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# GEMINI_STT_MODEL=gemini-3.8-flash
# Optional: our self-hosted OmniVoice engine (speech/ folder on a GPU machine).
# Setting SPEECH_URL makes it the speech engine (or force with SPEECH_PROVIDER=gemini|omnivoice).
SPEECH_URL=
SPEECH_TOKEN=

# ---- Google Maps Platform (directions, transit, places, weather, air quality). Server only.
# Google Cloud console -> enable Routes API, Places API (New), Weather API, Air Quality API ->
# Credentials -> API key restricted to those four APIs. Unset = Maps tools say "not set up",
# weather/air quality use Open-Meteo, buses use the sample timetable.
# The live sky (GET /api/ambient) uses the same key: Weather currentConditions + 3-day forecast,
# Air Quality, Routes (traffic probe, TRAFFIC_AWARE) and Places (New) searchText + searchNearby
# (bus stops). Up to 6 calls for a new ~1 km cell, then about 3 per 10 minutes while a screen
# stays open (stops and the city centre are kept a day, air quality 30 minutes; per server instance).
# Without the key it shows Open-Meteo weather and air only (no traffic, no stops).
GOOGLE_MAPS_API_KEY=
# Every Google call counts against this per-instance daily cap. The live snapshot may use only
# 60% of it, so questions (directions, places) always have quota left; past that it uses Open-Meteo.
# MAPS_DAILY_LIMIT=500

# ---- Public info for the privacy page (not secret)
NEXT_PUBLIC_REPO_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
